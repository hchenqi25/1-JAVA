package funciones;

public class direccion {

    public static void dibujarTriangulo(char letra, int anchura) {
      
        for (int i = 1; i <= anchura; i++) {

            for (int j = 1; j <= anchura; j++) {
               
                if (j <= i) {
                    System.out.print(letra);
                } else {
                    System.out.print(" ");   
                }
            }
            System.out.println(); 
        }
    }

    public static void main(String[] args) {
        dibujarTriangulo('*', 4);
    }
}