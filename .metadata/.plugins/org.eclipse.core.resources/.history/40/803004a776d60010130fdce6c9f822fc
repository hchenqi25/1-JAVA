package funciones;
public class Triangulo {

    public static void dibujarTriangulo(char letra, int anchura) {
  
        for (int j = anchura; j >= 1; j--) {
       
            for (int i = 1; j <=i; i++) {
                System.out.print(letra);
            }
           
            System.out.println();
        }
    }

    public static void main(String[] args) {
        
        dibujarTriangulo('*', 4);
    }
}