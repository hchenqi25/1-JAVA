package ejercicios_repaso;
import java.util.Scanner;

public class ejercicio5113 {

    public static void main(String[] args) {
        Scanner teclado = new Scanner(System.in);
        String frase = teclado.nextLine();

        StringBuilder frase1 = new StringBuilder(frase);

        // Muestro la frase original
        System.out.println("Frase original: " + frase1.toString());

        // Elimino espacios
        for (int i = 0; i < frase1.length(); i++) {
            if (frase1.charAt(i) == ' ') {
                frase1.deleteCharAt(i);
                i--; // Retroceder el índice para no saltarse el siguiente carácter
            }
        }
  // Muestro la frase sin espacios
        System.out.println("Frase sin espacios: " + frase1.toString());

        teclado.close();
    }
}
