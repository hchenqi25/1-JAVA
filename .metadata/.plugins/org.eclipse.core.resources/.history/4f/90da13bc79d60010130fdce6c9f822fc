package funciones;

public class direccion {

    public static void dibujarTriangulo(char letra, int anchura) {
       
        for (int i = 1; i <= anchura; i++) {
          
            for (int j = 1; j <= i; j++) {
            	if (anchura ==0) {
            		System.out.print(" *");
            		}else {
            			System.out.println();
            		}
                System.out.print(letra);
            }
            System.out.println(); 
        }
    }

    public static void main(String[] args) {
        dibujarTriangulo('*', 4);
    }
}