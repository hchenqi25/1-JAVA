package funciones;
public class Triangulo {

    public static void dibujarTriangulo(char letra, int anchura) {
        // Bucle desde la anchura inicial hasta 1
        for (int i = anchura; i >= 1; i--) {
            // Imprimir 'i' veces la letra
            for (int j = 1; j <= i; j++) {
                System.out.print(letra);
            }
            // Salto de línea al terminar cada fila
            System.out.println();
        }
    }

    public static void main(String[] args) {
        // Ejemplo de uso
        dibujarTriangulo('*', 4);
    }
}